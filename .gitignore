# gitignore

# Data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Outputs
results/
logs/

# Nextflow
work/
.nextflow/
.nextflow.log*

# PLINK logs
*.log

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Genomic Files (safeguard)
*.vcf
*.vcf.gz
*.bed
*.bim
*.fam
*.pgen
*.pvar
*.psam