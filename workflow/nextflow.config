// Config File

// Inputs
params.vcf  = "data/raw/ALL.chr22.phase3_shapeit2_mvncall_integrated_v5b.20130502.genotypes.vcf.gz"
params.id   = "chr22"
params.pheno = null
params.key   = null

// Variant and Sample QC
params.geno = 0.02          // variant missingness cutoff
params.maf  = 0.01          // minor allele frequency cutoff
params.king = 0.0884        // kinship cutoff

// LD Pruning
params.ld_window = 1000     // window size
params.ld_step   = 50       // step size within window
params.ld_r2     = 0.2      // variant correlation cutoff

// Association
params.n_pcs     = 10       // principal components


// Outputs
outputDir = "results/pipeline"

report {
    enabled   = true
    file      = "logs/report.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "logs/timeline.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "logs/trace.txt"
    overwrite = true
}